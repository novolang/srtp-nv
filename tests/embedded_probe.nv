// tests/embedded_probe.nv — this package's device claim, as a program
// that either builds for a Cortex-M or does not.
//
// THE CONSUMER IS A CONNECTED DEVICE THAT STREAMS MEDIA: a Cortex-M that
// sends microphone audio, or receives it, as RTP and has to protect the
// stream.  Everything it decides is here and is compiled for the hardware
// rather than claimed: the key derivation, the counter mode and the HMAC of
// RFC 3711, the AES-GCM of RFC 7714, the roll-over counter and the replay
// window, SRTCP, the keys taken from the bytes of a DTLS handshake and from
// an SDES attribute.  The socket is the caller's, so the probe passes the
// packets between the two ends in memory.
//
// What it checks, with the number of checks each adds:
//
//   - the cipher key of RFC 3711 appendix B.3, derived from its master key (2)
//   - the packet of RFC 7714 section 16.1.1, sealed, its tag and its cipher
//     compared with the RFC's bytes, and opened again (3)
//   - an AES_CM_128_HMAC_SHA1_80 packet protected to the bytes libsrtp
//     produces, unprotected, and refused a second time as a replay (3)
//   - an SRTCP packet protected, unprotected and refused when it is altered (3)
//   - an AEAD_AES_128_GCM stream across the roll-over of the sequence number (2)
//   - the contexts of a DTLS-SRTP handshake, one end's packet read by the other (2)
//   - the RFC 4568 attribute read, and a context set up from it (3)
//
// The score is the sum, and a device that disagrees with the host prints how
// many it lost.

use std.str
use rtpbytes
use srtpaes
use srtpctx
use srtpdtls
use srtpgcm
use srtpkdf
use srtpsdes
use srtp

// The packet libsrtp makes of 80000001000000a01122334401020304 05 under the
// key 000102...0f and the salt a0a1...ad.
const LIBSRTP_PACKET = [0x80, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0xa0, 0x11, 0x22, 0x33, 0x44,
                        0x1f, 0x3d, 0x4b, 0xaf, 0x56, 0x21, 0x88, 0xc9, 0x36, 0x8c, 0xd2, 0x9b,
                        0x26, 0xef, 0x11]

// The byte strings the probe reads.
const DATA_1 = [0xE1, 0xF9, 0x7A, 0x0D, 0x3E, 0x01, 0x8B, 0xE0, 0xD6, 0x4F, 0xA3, 0x2C, 0x06, 0xDE, 0x41, 0x39]
const DATA_2 = [0x0E, 0xC6, 0x75, 0xAD, 0x49, 0x8A, 0xFE, 0xEB, 0xB6, 0x96, 0x0B, 0x3A, 0xAB, 0xE6]
const DATA_3 = [0x51, 0x75, 0x3c, 0x65, 0x80, 0xc2, 0x72, 0x6f, 0x20, 0x71, 0x84, 0x14]
const DATA_4 = [0x80, 0x40, 0xf1, 0x7b, 0x80, 0x41, 0xf8, 0xd3, 0x55, 0x01, 0xa0, 0xb2]
const DATA_5 = [0x81, 0xC8, 0, 3, 0x11, 0x22, 0x33, 0x44, 1, 2, 3, 4, 5, 6, 7, 8]

// The master key 0, 1, 2, ... of a profile.
@tier(embedded)
@no_alloc
fn master_key(n: Int) -> srtpaes.SrtpBytes []
    var k: srtpaes.SrtpBytes = Vec.new()
    for i in 0..n
        let _ = k.push(i as u8)
    k

// The master salt 0xA0, 0xA1, ... of a profile.
@tier(embedded)
@no_alloc
fn master_salt(n: Int) -> srtpaes.SrtpBytes []
    var s: srtpaes.SrtpBytes = Vec.new()
    for i in 0..n
        let _ = s.push((0xA0 + i) as u8)
    s

// A context for a profile with the key and salt above.
@tier(embedded)
@no_alloc
fn context(profile: Int) -> srtpctx.SrtpCtx []
    var c = srtpctx.empty()
    var k = master_key(srtpctx.key_len(profile))
    var s = master_salt(srtpctx.salt_len(profile))
    let _ = srtpctx.init(var c, profile, var k, var s, 0)
    c

// An RTP packet of sequence number `seq` with five payload bytes.
@tier(embedded)
@no_alloc
fn rtp_packet(seq: Int, ssrc: Int) -> rtpbytes.RtpBuf []
    var p: rtpbytes.RtpBuf = Vec.new()
    let _ = rtpbytes.put_u16(var p, 0x8000)
    let _ = rtpbytes.put_u16(var p, seq)
    let _ = rtpbytes.put_u32(var p, 160)
    let _ = rtpbytes.put_u32(var p, ssrc)
    for i in 1..6
        let _ = rtpbytes.put_u8(var p, i)
    p

// The key derivation and the GCM packet of the RFCs: five checks.
@tier(embedded)
@no_alloc
fn rfc_score() -> Int []
    var n = 0
    var mk: srtpaes.SrtpBytes = Vec.new()
    for i in 0..16
        let _ = mk.push(DATA_1[i] as u8)
    var salt: srtpaes.SrtpBytes = Vec.new()
    for i in 0..14
        let _ = salt.push(DATA_2[i] as u8)
    var out: srtpaes.SrtpBytes = Vec.new()
    srtpkdf.derive(srtpaes.expand(var mk, 16), var salt, srtpkdf.SRTP_LABEL_RTP_ENC, 0, 16, var out)
    // RFC 3711 appendix B.3: the cipher key is C61E7A93744F39EE10734AFE3FF7A087.
    if out.len() == 16 and out[0] == 0xC6 and out[15] == 0x87
        n = n + 1
    if out[6] == 0x39 and out[7] == 0xEE
        n = n + 1
    // RFC 7714 section 16.1.1: the key 000102...0f, the IV 51753c65...8414,
    // the header as additional data and a payload of 38 bytes.
    var key: srtpaes.SrtpBytes = master_key(16)
    var gk = srtpgcm.key(var key, 16)
    var iv: srtpaes.SrtpBytes = Vec.new()
    for i in 0..12
        let _ = iv.push(DATA_3[i] as u8)
    var p: rtpbytes.RtpBuf = Vec.new()
    for i in 0..12
        let _ = p.push(DATA_4[i] as u8)
    let text = "Gallia est omnis divisa in partes tres"
    for i in 0..str.len(text)
        let _ = p.push(str.byte_at_or(text, i, 0) as u8)
    let sealed = srtpgcm.seal(var gk, var iv, var p, 12, false, 0, 38)
    // The cipher starts f24de3a3 and the tag ends 765ee4390cce.
    if sealed and p.len() == 66 and p[12] == 0xf2 and p[13] == 0x4d and p[64] == 0x0c and p[65] == 0xce
        n = n + 1
    if srtpgcm.open(var gk, var iv, var p, 12, false, 0, 38) and p.len() == 50 and p[12] == 0x47
        n = n + 1
    p[13] = 0 as u8
    if not srtpgcm.open(var gk, var iv, var p, 12, false, 0, 38)
        n = n + 1
    n

// A counter-mode stream, compared with libsrtp, and its replay: three checks.
@tier(embedded)
@no_alloc
fn cm_score() -> Int []
    var n = 0
    var tx = context(srtpctx.SRTP_AES128_CM_SHA1_80)
    var rx = context(srtpctx.SRTP_AES128_CM_SHA1_80)
    var p = rtp_packet(1, 0x11223344)
    let st = srtp.protect_rtp(var tx, var p)
    var same = st == srtpctx.SRTP_OK and p.len() == 27
    for i in 0..27
        if same and (p[i] as Int) != LIBSRTP_PACKET[i]
            same = false
    if same
        n = n + 1
    if srtp.unprotect_rtp(var rx, var p) == srtpctx.SRTP_OK and p.len() == 17 and p[16] == 5
        n = n + 1
    var other = context(srtpctx.SRTP_AES128_CM_SHA1_80)
    var copy = rtp_packet(1, 0x11223344)
    let _ = srtp.protect_rtp(var other, var copy)
    if srtp.unprotect_rtp(var rx, var copy) == srtpctx.SRTP_ERR_REPLAY
        n = n + 1
    n

// An SRTCP packet protected, read and refused when altered: three checks.
@tier(embedded)
@no_alloc
fn rtcp_score() -> Int []
    var n = 0
    var tx = context(srtpctx.SRTP_AES256_CM_SHA1_80)
    var rx = context(srtpctx.SRTP_AES256_CM_SHA1_80)
    var p: rtpbytes.RtpBuf = Vec.new()
    for i in 0..16
        let _ = p.push(DATA_5[i] as u8)
    if srtp.protect_rtcp(var tx, var p, true) == srtpctx.SRTP_OK and p.len() == 16 + 4 + 10
        n = n + 1
    var bad = p
    bad[9] = (bad[9] as Int ^ 1) as u8
    if srtp.unprotect_rtcp(var rx, var bad) == srtpctx.SRTP_ERR_AUTH
        n = n + 1
    if srtp.unprotect_rtcp(var rx, var p) == srtpctx.SRTP_OK and p.len() == 16 and p[15] == 8
        n = n + 1
    n

// AES-GCM across the roll-over of the sequence number: two checks.
@tier(embedded)
@no_alloc
fn gcm_score() -> Int []
    var n = 0
    var tx = context(srtpctx.SRTP_AEAD_AES128_GCM)
    var rx = context(srtpctx.SRTP_AEAD_AES128_GCM)
    var ok = true
    for k in 0..4
        var p = rtp_packet((65534 + k) & 0xFFFF, 0x11223344)
        ok = ok and srtp.protect_rtp(var tx, var p) == srtpctx.SRTP_OK
        ok = ok and srtp.unprotect_rtp(var rx, var p) == srtpctx.SRTP_OK
    if ok
        n = n + 1
    if tx.rtp.top == 65536 + 1 and rx.rtp.top == 65536 + 1
        n = n + 1
    n

// The two ends of a DTLS-SRTP handshake: two checks.
@tier(embedded)
@no_alloc
fn dtls_score() -> Int []
    var n = 0
    var e: srtpdtls.SrtpExporter = Vec.new()
    for i in 0..srtpdtls.exporter_len(srtpctx.SRTP_AEAD_AES256_GCM)
        let _ = e.push((i * 5 + 3) as u8)
    var c_send = srtpctx.empty()
    var c_recv = srtpctx.empty()
    var s_send = srtpctx.empty()
    var s_recv = srtpctx.empty()
    let a = srtpdtls.contexts(srtpctx.SRTP_AEAD_AES256_GCM, var e, true, var c_send, var c_recv)
    let b = srtpdtls.contexts(srtpctx.SRTP_AEAD_AES256_GCM, var e, false, var s_send, var s_recv)
    if a == srtpctx.SRTP_OK and b == srtpctx.SRTP_OK
        n = n + 1
    var p = rtp_packet(9, 0x01020304)
    let _ = srtp.protect_rtp(var c_send, var p)
    if srtp.unprotect_rtp(var s_recv, var p) == srtpctx.SRTP_OK and p.len() == 17
        n = n + 1
    n

// The attribute of RFC 4568 section 6.1 and a context made from it: three checks.
@tier(embedded)
@no_alloc
fn sdes_score() -> Int []
    var n = 0
    let a = srtpsdes.parse("1 AES_CM_128_HMAC_SHA1_80 inline:d0RmdmcmVCspeEc3QGZiNWpVLFJhQX1cfHAwJSoj|2^20|1:4")
    if a.status == srtpsdes.SDES_OK and a.lifetime == 1048576 and a.mki == 1 and a.mki_len == 4
        n = n + 1
    if a.key[0] == 0x77 and a.key[15] == 0x35 and a.salt[0] == 0x6a and a.salt[13] == 0x23
        n = n + 1
    var c = srtpctx.empty()
    var t: srtpsdes.SdesText = Vec.new()
    if srtpsdes.init_ctx(var c, a) == srtpctx.SRTP_OK and srtpsdes.write(a, var t) and t.len() == 82
        n = n + 1
    n

// Every answer this probe checks, folded into one number so a single
// comparison decides the run.
@tier(embedded)
fn score() -> Int []
    rfc_score() + cm_score() + rtcp_score() + gcm_score() + dtls_score() + sdes_score()

@tier(rt)
fn main() [hw]
    bsp.board.init()
    // 18 is the number of checks in `score`.  The count is printed on a
    // failure rather than only compared, so a device that disagrees with
    // the host says how many it lost.
    let n = score()
    if n == 18
        hal.uart.write("PASS: srtp-embedded\n")
    else
        hal.uart.write("FAIL: srtp-embedded score=")
        hal.uart.write(str.from_int(n))
        hal.uart.write("\n")
    loop
        hal.timer.delay_ms(1000)
