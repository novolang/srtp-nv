fn test_gcm128_rtp_packets_match_libsrtp() [io]
    test.case("AEAD_AES_128_GCM: four RTP packets, the last with a CSRC and an extension")
    var tx = ctx_of(srtpctx.SRTP_AEAD_AES128_GCM)
    var rx = ctx_of(srtpctx.SRTP_AEAD_AES128_GCM)
    check_rtp(var tx, var rx, "80000001000000a0112233440102030405",
              "80000001000000a011223344dd0c5220daca810261d95f5c5ee0f69dbc57f90cc5")
    check_rtp(var tx, var rx, "80000002000000a01122334402030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20212223242526272829",
              "80000002000000a011223344a6a8ae9268adda424b6eb5e358b58d49205047c5bc4dace459e4da49b8f7c5470465f11f28a28a4aa90617899f87fa79c6829a9e91ab428f")
    check_rtp(var tx, var rx, "80000003000000a011223344",
              "80000003000000a011223344257ed36ebac14d26dbc0e3e37184051f")
    check_rtp(var tx, var rx, "916000040000014011223344cafebabebede000110aa0000090a0b0c0d0e0f",
              "916000040000014011223344cafebabebede000110aa000095c587cb4bf38c39c4a47f210bdfd1025fa8e58fa9212d")

