    test.assert_eq(srtpctx.set_rtcp_index(var tx, 1), srtpctx.SRTP_OK)
    check_rtcp(var tx, var rx, "81c8000611223344404142434445464748494a4b4c4d4e4f50515253",
               "81c8000611223344317ed17cb5652718eaac28c064004782e0990cfd655c75335d96dc28ce5a7be8b22b913080000001", true)
    check_rtcp(var tx, var rx, "81c80007112233444142434445464748494a4b4c4d4e4f505152535455565758",
               "81c80007112233446d1b17c86b5de5fda6f3ee7d70ca9493877b213b6c02e250a6666fb59ae5b18ef52a65ce2a3997c680000002", true)
    check_rtcp(var tx, var rx, "81c800081122334442434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d",
               "81c8000811223344b3e2c7e2a8b9601e0d935231a5fb58a57a3216125b4317e914169a4d5c2790b80dbd5fc4d05537bd59279d2480000003", true)
    test.case("AEAD_AES_256_GCM: an RTCP packet that is only authenticated, the E bit clear")
    var ta = ctx_of(srtpctx.SRTP_AEAD_AES256_GCM)
    var ra = ctx_of(srtpctx.SRTP_AEAD_AES256_GCM)
    test.assert_eq(srtpctx.set_rtcp_index(var ta, 1), srtpctx.SRTP_OK)
    check_rtcp(var ta, var ra, "81c8000711223344707172737475767778797a7b7c7d7e7f8081828384858687",
               "81c8000711223344707172737475767778797a7b7c7d7e7f8081828384858687dcdec5c5e5e976a204ddcfec04d59efd00000001", false)

@test
fn test_cm128_80_rollover_counter_is_carried_across_the_sequence_wrap() [io]
    test.case("AES_CM_128_HMAC_SHA1_80: sequence numbers 65534, 65535, 0, 1, 2 give the ROC 0, 0, 1, 1, 1")
    var tx = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    var rx = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    check_rtp(var tx, var rx, "8000fffe000000a011223344feff000102030405",
              "8000fffe000000a011223344a5cdb6d5d05ad9d30ed5498de05c36ea945c")
    check_rtp(var tx, var rx, "8000ffff000000a011223344ff00010203040506",
              "8000ffff000000a01122334482495e29e121c52f5374013f0be7d7069bc5")
    check_rtp(var tx, var rx, "80000000000000a0112233440001020304050607",
              "80000000000000a0112233447f102e7aca7c03498ef08880ebfb97ffc978")
    check_rtp(var tx, var rx, "80000001000000a0112233440102030405060708",
              "80000001000000a011223344d0b98bb2793208837eb5a832bed087d0f527")
    check_rtp(var tx, var rx, "80000002000000a0112233440203040506070809",
              "80000002000000a011223344797dbf8a851a2c72cd4ad1e48052a409e124")
    test.assert_eq(tx.rtp.top, 65536 + 2)
    test.assert_eq(rx.rtp.top, 65536 + 2)

@test
fn test_gcm128_rollover_counter_is_carried_across_the_sequence_wrap() [io]
    test.case("AEAD_AES_128_GCM: sequence numbers 65534, 65535, 0, 1, 2 give the ROC 0, 0, 1, 1, 1")
    var tx = ctx_of(srtpctx.SRTP_AEAD_AES128_GCM)
    var rx = ctx_of(srtpctx.SRTP_AEAD_AES128_GCM)
    check_rtp(var tx, var rx, "8000fffe000000a011223344feff000102030405",
              "8000fffe000000a011223344d911498792e28a9b44e291646df1c7ad8f0913e80fab8719")
    check_rtp(var tx, var rx, "8000ffff000000a011223344ff00010203040506",
              "8000ffff000000a011223344f7a3e044deb54d912809f96c682f635b9ea09a5b6efd632d")
    check_rtp(var tx, var rx, "80000000000000a0112233440001020304050607",
              "80000000000000a011223344de65ec4e71969e551cba144a1c09ad896f6e7a6c3072bd63")
    check_rtp(var tx, var rx, "80000001000000a0112233440102030405060708",
              "80000001000000a01122334418e4768a2ced7f25648a21f4dbbbf7880bd7d8bd3a23dfcc")
    check_rtp(var tx, var rx, "80000002000000a0112233440203040506070809",
              "80000002000000a0112233447fd3acd7a6e0ae23a63c9e84248e38d8bb1b70ad2d866a45")
    test.assert_eq(tx.rtp.top, 65536 + 2)
    test.assert_eq(rx.rtp.top, 65536 + 2)
