fn test_cm256_80_rtp_packets_match_libsrtp() [io]
    test.case("AES_CM_256_HMAC_SHA1_80: four RTP packets, the last with a CSRC and an extension")
    var tx = ctx_of(srtpctx.SRTP_AES256_CM_SHA1_80)
    var rx = ctx_of(srtpctx.SRTP_AES256_CM_SHA1_80)
    check_rtp(var tx, var rx, "80000001000000a0112233440102030405",
              "80000001000000a0112233440cdf0376de14ebd758a6cb629a1c23")
    check_rtp(var tx, var rx, "80000002000000a01122334402030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20212223242526272829",
              "80000002000000a011223344996c1cb85ec8aee919ccea967e6cf685e6a377c5dde2cf72483ce89f84769898701b736ff69dffedfe8dac21fa66690f6b3d")
    check_rtp(var tx, var rx, "80000003000000a011223344",
              "80000003000000a01122334440ea953835a5902dcc4b")
    check_rtp(var tx, var rx, "916000040000014011223344cafebabebede000110aa0000090a0b0c0d0e0f",
              "916000040000014011223344cafebabebede000110aa0000f5cb6b97d1fc0df4ab3ee6ba7c8b88f41c")

@test
fn test_cm256_80_rtcp_packets_match_libsrtp() [io]
    test.case("AES_CM_256_HMAC_SHA1_80: three encrypted RTCP packets, SRTCP index 1, 2, 3")
    var tx = ctx_of(srtpctx.SRTP_AES256_CM_SHA1_80)
    var rx = ctx_of(srtpctx.SRTP_AES256_CM_SHA1_80)
    test.assert_eq(srtpctx.set_rtcp_index(var tx, 1), srtpctx.SRTP_OK)
    check_rtcp(var tx, var rx, "81c8000611223344404142434445464748494a4b4c4d4e4f50515253",
               "81c800061122334487a7af72ea89c49edeccb5cc1991b6657a8a740e800000015f90f6a53ee6399475a1", true)
    check_rtcp(var tx, var rx, "81c80007112233444142434445464748494a4b4c4d4e4f505152535455565758",
               "81c8000711223344670c3c671645a97cece03626e7c1f66e07e783fa48d9bca680000002730184b8ce5cbd230169", true)
    check_rtcp(var tx, var rx, "81c800081122334442434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d",
               "81c8000811223344977856218e65cffe452e905a1c801b451a7ca8b54be2163c4d10d9af80000003b1ed6ae8897c3eb3168d", true)
    test.case("AES_CM_256_HMAC_SHA1_80: an RTCP packet that is only authenticated, the E bit clear")
    var ta = ctx_of(srtpctx.SRTP_AES256_CM_SHA1_80)
    var ra = ctx_of(srtpctx.SRTP_AES256_CM_SHA1_80)
    test.assert_eq(srtpctx.set_rtcp_index(var ta, 1), srtpctx.SRTP_OK)
    check_rtcp(var ta, var ra, "81c8000711223344707172737475767778797a7b7c7d7e7f8081828384858687",
               "81c8000711223344707172737475767778797a7b7c7d7e7f80818283848586870000000147c1a255866498838d71", false)

