// srtp_tests.nv — whole SRTP and SRTCP packets, against libsrtp.
//
// THE PACKETS ARE FROM AN INDEPENDENT IMPLEMENTATION.  RFC 3711 and RFC 7714
// print no complete packet for the counter-mode profiles, and RFC 7714 prints
// its packets under session keys rather than master keys, so the packets
// here were protected by libsrtp 2 (the Cisco library that browsers and
// GStreamer use, version 2.5 of Ubuntu 24.04) driven through Python's
// ctypes.  Each profile was created with
//
//     master key   000102...0f (AES-128) or 000102...1f (AES-256)
//     master salt  a0a1a2...ad (14 bytes) or a0a1a2...ab (12 bytes, AES-GCM)
//     SSRC         0x11223344, key derivation rate 0, no MKI
//
// and `srtp_protect` / `srtp_protect_rtcp` called on the plain packets in
// the test, in order.  The test checks both directions: this package
// protects the plain packet to the same bytes, and unprotects libsrtp's
// bytes to the plain packet.
//
// libsrtp sends the first SRTCP packet with the index 1 and RFC 3711 section
// 3.4 says the index is zero before the first packet is sent, so the
// tests set the index to 1 for the comparison and a test at the end of
// `srtp_edge_tests.nv` shows the default of 0.

use std.str
use std.test
use rtpbytes
use srtpaes
use srtpctx
use srtp

// The value of a hexadecimal digit, or -1.
fn hexval(c: Int) -> Int
    if c >= 48 and c <= 57
        return c - 48
    if c >= 97 and c <= 102
        return c - 87
    -1

// A packet from a hexadecimal dump, lower case.
fn pkt_hex(s: Str) -> rtpbytes.RtpBuf
    var m: rtpbytes.RtpBuf = Vec.new()
    var hi = -1
    for i in 0..str.len(s)
        let v = hexval(str.byte_at_or(s, i, 0))
        if v >= 0
            if hi < 0
                hi = v
            else
                let _ = m.push((hi * 16 + v) as u8)
                hi = -1
    m

fn digit(v: Int) -> Int
    if v < 10
        return 48 + v
    87 + v

// The lower-case hexadecimal of a packet.
fn hex_of(var d: rtpbytes.RtpBuf) -> Str
    var s = ""
    for i in 0..d.len()
        let b = d[i] as Int
        s = s + str.from_byte(digit(b >> 4)) + str.from_byte(digit(b & 15))
    s

// The master key of a profile: 0 through 15, or 0 through 31 for AES-256.
fn master_key(profile: Int) -> srtpaes.SrtpBytes
    var k: srtpaes.SrtpBytes = Vec.new()
    for i in 0..srtpctx.key_len(profile)
        let _ = k.push(i as u8)
    k

// The master salt of a profile: 0xA0 and up, 14 bytes or 12 for AES-GCM.
fn master_salt(profile: Int) -> srtpaes.SrtpBytes
    var s: srtpaes.SrtpBytes = Vec.new()
    for i in 0..srtpctx.salt_len(profile)
        let _ = s.push((0xA0 + i) as u8)
    s

// A context for the profile with the key and salt above.
fn ctx_of(profile: Int) -> srtpctx.SrtpCtx
    var c = srtpctx.empty()
    var k = master_key(profile)
    var s = master_salt(profile)
    test.assert_eq(srtpctx.init(var c, profile, var k, var s, 0), srtpctx.SRTP_OK)
    c

// Protect `plain` with the sender and compare with `prot`; unprotect `prot`
// with the receiver and compare with `plain`.
fn check_rtp(var tx: srtpctx.SrtpCtx, var rx: srtpctx.SrtpCtx, plain: Str, prot: Str)
    var p = pkt_hex(plain)
    test.assert_eq(srtp.protect_rtp(var tx, var p), srtpctx.SRTP_OK)
    test.assert_eq(hex_of(var p), prot)
    var q = pkt_hex(prot)
    test.assert_eq(srtp.unprotect_rtp(var rx, var q), srtpctx.SRTP_OK)
    test.assert_eq(hex_of(var q), plain)

// The same for a compound RTCP packet.
fn check_rtcp(var tx: srtpctx.SrtpCtx, var rx: srtpctx.SrtpCtx, plain: Str, prot: Str,
              encrypt: Bool)
    var p = pkt_hex(plain)
    test.assert_eq(srtp.protect_rtcp(var tx, var p, encrypt), srtpctx.SRTP_OK)
    test.assert_eq(hex_of(var p), prot)
    var q = pkt_hex(prot)
    test.assert_eq(srtp.unprotect_rtcp(var rx, var q), srtpctx.SRTP_OK)
    test.assert_eq(hex_of(var q), plain)

@test
fn test_cm128_80_rtp_packets_match_libsrtp() [io]
    test.case("AES_CM_128_HMAC_SHA1_80: four RTP packets, the last with a CSRC and an extension")
    var tx = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    var rx = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    check_rtp(var tx, var rx, "80000001000000a0112233440102030405",
              "80000001000000a0112233441f3d4baf562188c9368cd29b26ef11")
    check_rtp(var tx, var rx, "80000002000000a01122334402030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20212223242526272829",
              "80000002000000a0112233445fcc9b35cfc300330375a76614cc7d03fdf7f5db5042e0b51d30be91d9bdad136bdce47e89ce2a8c10fac306454becaada7c")
    check_rtp(var tx, var rx, "80000003000000a011223344",
              "80000003000000a0112233448c7b7c12c047de8d83e1")
    check_rtp(var tx, var rx, "916000040000014011223344cafebabebede000110aa0000090a0b0c0d0e0f",
              "916000040000014011223344cafebabebede000110aa0000ff0658cd0008f95db50dcefdfdfd68c318")

@test
fn test_cm128_80_rtcp_packets_match_libsrtp() [io]
    test.case("AES_CM_128_HMAC_SHA1_80: three encrypted RTCP packets, SRTCP index 1, 2, 3")
    var tx = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    var rx = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    test.assert_eq(srtpctx.set_rtcp_index(var tx, 1), srtpctx.SRTP_OK)
    check_rtcp(var tx, var rx, "81c8000611223344404142434445464748494a4b4c4d4e4f50515253",
               "81c800061122334437a546722fbdbdb9cb083c5fe2b7b5e654f10c4680000001b398a63b059734a1ccff", true)
    check_rtcp(var tx, var rx, "81c80007112233444142434445464748494a4b4c4d4e4f505152535455565758",
               "81c8000711223344c91f00772e06ab0978d532292b7087b11739ec29b09c5ec0800000029f2e6c3c9db4a0c73161", true)
    check_rtcp(var tx, var rx, "81c800081122334442434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d",
               "81c8000811223344d6e608f78b5009f8759fab49309322ea5fa90ff15ad6cd1fd1bc898780000003df694ed46f1a3b513005", true)
    test.case("AES_CM_128_HMAC_SHA1_80: an RTCP packet that is only authenticated, the E bit clear")
    var ta = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    var ra = ctx_of(srtpctx.SRTP_AES128_CM_SHA1_80)
    test.assert_eq(srtpctx.set_rtcp_index(var ta, 1), srtpctx.SRTP_OK)
    check_rtcp(var ta, var ra, "81c8000711223344707172737475767778797a7b7c7d7e7f8081828384858687",
               "81c8000711223344707172737475767778797a7b7c7d7e7f808182838485868700000001ebbf5a5504adea6af92a", false)

